# Supabase 接続情報
# Supabase ダッシュボード > Settings > API からコピーしてください
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# サイトログイン情報の暗号化キー
# 32文字以上のランダム文字列を設定してください。実値はコミットしないでください。
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Google Gemini API（ReAct エージェントの推論エンジン）
# https://aistudio.google.com/app/apikey から取得
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# Tavily Web Search API（エージェントのウェブ検索ツール）
# https://app.tavily.com から取得
TAVILY_API_KEY=tvly-your-api-key

# JWT 認証キー（本番環境では長い秘密鍵に変更してください）
# 32 文字以上のランダム文字列を使用してください
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret

# CORS 許可オリジン（カンマ区切り）
# 未設定時はローカル開発用に http://localhost:8000 のみ許可
CORS_ALLOW_ORIGINS=http://localhost:8000

# Notion Integration（エージェントの書き込み先）
# https://www.notion.so/my-integrations でインテグレーションを作成して取得
NOTION_API_KEY=secret_your-notion-api-key
# 書き込み先データベースの ID（URL の /xxx?v=... の xxx 部分）
NOTION_DATABASE_ID=your-notion-database-id

# SendGrid メール送信（パスワードリセットメール等）
# https://app.sendgrid.com から取得してください
SENDGRID_API_KEY=SG.your-sendgrid-api-key
# メール送信元のメールアドレス（Sender Authentication を完了した本人確認済みメール）
SENDGRID_FROM_EMAIL=noreply@example.com

# パスワードリセット URL（フロントエンドのリセットページ URL）
# トークンはクエリパラメータ ?token= として追加されます
RESET_PASSWORD_URL=http://localhost:3000/reset-password
