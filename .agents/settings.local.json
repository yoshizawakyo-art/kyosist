{
  "permissions": {
    "allow": [
      "Bash(rtk ls *)",
      "Bash(rtk find *)",
      "Bash(gh auth *)",
      "Bash(git --version)",
      "Bash(git config *)",
      "Bash(git init *)",
      "Bash(rtk git *)",
      "Bash(rtk git commit -m ' *)",
      "Bash(git remote *)",
      "Bash(rtk pip *)",
      "PowerShell(pip *)",
      "PowerShell(python -m pip --version 2>&1)",
      "PowerShell(Get-Command *)",
      "Bash(rtk ruff *)",
      "PowerShell(& \"C:\\Program Files\\GitHub CLI\\gh.exe\" pr *)",
      "PowerShell(& \"C:\\Program Files\\GitHub CLI\\gh.exe\" auth status)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"[System.Media.SystemSounds]::Asterisk.Play(); Start-Sleep -Milliseconds 500\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/hooks/check-reminder.ps1"
          }
        ]
      }
    ]
  }
}
