{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/favicon.ico", "dest": "/public/favicon.png" },
    { "src": "/chat/?$", "dest": "/public/chat/index.html" },
    { "src": "/chat/(.*)", "dest": "/public/chat/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
